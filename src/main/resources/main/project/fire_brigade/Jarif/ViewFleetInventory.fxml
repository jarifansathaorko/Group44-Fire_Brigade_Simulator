<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.project.fire_brigade.Jarif.ViewFleetInventoryController">
   <children>
      <VBox prefHeight="603.0" prefWidth="800.0" spacing="10.0">
         <children>
            <HBox alignment="BOTTOM_CENTER" prefHeight="81.0" prefWidth="800.0">
               <children>
                  <Label prefHeight="53.0" prefWidth="351.0" text="View Fleet Inventory">
                     <font>
                        <Font name="System Bold" size="36.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="BOTTOM_CENTER" prefHeight="55.0" prefWidth="800.0">
               <children>
                  <Button fx:id="loadFleetButton" mnemonicParsing="false" prefHeight="39.0" prefWidth="141.0" text="Load Fleet">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <HBox alignment="BOTTOM_CENTER" prefHeight="19.0" prefWidth="800.0" />
            <TableView fx:id="fleetTable" prefHeight="393.0" prefWidth="800.0">
              <columns>
                <TableColumn prefWidth="110.0" text="Vehicle ID" />
                <TableColumn prefWidth="120.0" text="Vehicle Type" />
                  <TableColumn prefWidth="122.0" text="Model" />
                  <TableColumn prefWidth="150.0" text="Registration Number" />
                  <TableColumn prefWidth="110.0" text="Year" />
                  <TableColumn prefWidth="147.0" text="Category" />
              </columns>
            </TableView>
            <HBox prefHeight="55.0" prefWidth="772.0" spacing="10.0">
               <children>
                  <Label alignment="CENTER" prefHeight="39.0" prefWidth="251.0" text="Total Vehicles:" textAlignment="CENTER">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalCountLabel" prefHeight="55.0" prefWidth="664.0" text="-" textAlignment="CENTER">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
