<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.project.fire_brigade.Junayeed.GoalController">
    <children>
        <Label fx:id="headingLabel" layoutX="80.0" layoutY="20.0" prefHeight="30.0" prefWidth="680.0" text="View Current Emergencies" />
        <Label fx:id="descriptionLabel" layoutX="80.0" layoutY="58.0" prefHeight="35.0" prefWidth="680.0" text="Overview of all active emergencies and assigned trucks." wrapText="true" />
        <Button fx:id="actionButton" layoutX="245.0" layoutY="108.0" mnemonicParsing="false" onAction="#actionButtonOnAction" prefWidth="145.0" text="Refresh Emergencies" />
        <Button layoutX="400.0" layoutY="108.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefWidth="145.0" text="Back to Dashboard" />
        <Label layoutX="80.0" layoutY="158.0" text="SYSTEM RESPONSE" />
        <TextArea fx:id="resultTA" editable="false" layoutX="80.0" layoutY="183.0" prefHeight="417.0" prefWidth="680.0" wrapText="true" />
    </children>
</AnchorPane>