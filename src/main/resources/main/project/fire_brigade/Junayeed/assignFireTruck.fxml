<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.project.fire_brigade.Junayeed.GoalController">
    <children>
        <Label fx:id="headingLabel" layoutX="80.0" layoutY="20.0" prefHeight="30.0" prefWidth="680.0" text="Assign a Fire Truck" />
        <Label fx:id="descriptionLabel" layoutX="80.0" layoutY="58.0" prefHeight="35.0" prefWidth="680.0" text="Assign an available fire truck to an active emergency." wrapText="true" />
        <Label fx:id="fieldOneLabel" layoutX="80.0" layoutY="112.0" prefWidth="150.0" text="Truck Number" />
        <TextField fx:id="fieldOneTF" layoutX="245.0" layoutY="108.0" prefWidth="300.0" promptText="e.g. FT-101" />
        <Label fx:id="fieldTwoLabel" layoutX="80.0" layoutY="153.0" prefWidth="150.0" text="Emergency ID" />
        <TextField fx:id="fieldTwoTF" layoutX="245.0" layoutY="149.0" prefWidth="300.0" promptText="e.g. EM-2026-01" />
        <Button fx:id="actionButton" layoutX="245.0" layoutY="200.0" mnemonicParsing="false" onAction="#actionButtonOnAction" prefWidth="145.0" text="Assign Truck" />
        <Button layoutX="400.0" layoutY="200.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefWidth="145.0" text="Back to Dashboard" />
        <Label layoutX="80.0" layoutY="250.0" text="SYSTEM RESPONSE" />
        <TextArea fx:id="resultTA" editable="false" layoutX="80.0" layoutY="275.0" prefHeight="325.0" prefWidth="680.0" wrapText="true" />
    </children>
</AnchorPane>