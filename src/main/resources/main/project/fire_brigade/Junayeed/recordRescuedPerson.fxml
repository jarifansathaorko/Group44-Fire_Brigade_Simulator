<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.project.fire_brigade.Junayeed.GoalController">
    <children>
        <Label fx:id="headingLabel" layoutX="80.0" layoutY="20.0" prefHeight="30.0" prefWidth="680.0" text="Record Rescued Person" />
        <Label fx:id="descriptionLabel" layoutX="80.0" layoutY="58.0" prefHeight="35.0" prefWidth="680.0" text="Register details and medical condition of a rescued individual." wrapText="true" />
        <Label fx:id="fieldOneLabel" layoutX="80.0" layoutY="112.0" prefWidth="150.0" text="Person Name" />
        <TextField fx:id="fieldOneTF" layoutX="245.0" layoutY="108.0" prefWidth="300.0" promptText="Enter full name" />
        <Label fx:id="fieldTwoLabel" layoutX="80.0" layoutY="153.0" prefWidth="150.0" text="Age" />
        <TextField fx:id="fieldTwoTF" layoutX="245.0" layoutY="149.0" prefWidth="300.0" promptText="Enter age" />
        <Label fx:id="fieldThreeLabel" layoutX="80.0" layoutY="194.0" prefWidth="150.0" text="Condition" />
        <TextField fx:id="fieldThreeTF" layoutX="245.0" layoutY="190.0" prefWidth="300.0" promptText="e.g. Stable, Injured" />
        <Button fx:id="actionButton" layoutX="245.0" layoutY="241.0" mnemonicParsing="false" onAction="#actionButtonOnAction" prefWidth="145.0" text="Save Record" />
        <Button layoutX="400.0" layoutY="241.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefWidth="145.0" text="Back to Dashboard" />
        <Label layoutX="80.0" layoutY="291.0" text="SYSTEM RESPONSE" />
        <TextArea fx:id="resultTA" editable="false" layoutX="80.0" layoutY="316.0" prefHeight="284.0" prefWidth="680.0" wrapText="true" />
    </children>
</AnchorPane>