<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.project.fire_brigade.Junayeed.GoalController">
    <children>
        <Label fx:id="headingLabel" layoutX="80.0" layoutY="20.0" prefHeight="30.0" prefWidth="680.0" text="Accept a Rescue Mission" />
        <Label fx:id="descriptionLabel" layoutX="80.0" layoutY="58.0" prefHeight="35.0" prefWidth="680.0" text="Enter a mission ID to accept and initiate rescue operations." wrapText="true" />
        <Label fx:id="fieldOneLabel" layoutX="80.0" layoutY="112.0" prefWidth="150.0" text="Mission ID" />
        <TextField fx:id="fieldOneTF" layoutX="245.0" layoutY="108.0" prefWidth="300.0" promptText="e.g. RM-101" />
        <Button fx:id="actionButton" layoutX="245.0" layoutY="159.0" mnemonicParsing="false" onAction="#actionButtonOnAction" prefWidth="145.0" text="Accept Mission" />
        <Button layoutX="400.0" layoutY="159.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefWidth="145.0" text="Back to Dashboard" />
        <Label layoutX="80.0" layoutY="209.0" text="SYSTEM RESPONSE" />
        <TextArea fx:id="resultTA" editable="false" layoutX="80.0" layoutY="234.0" prefHeight="366.0" prefWidth="680.0" wrapText="true" />
    </children>
</AnchorPane>